# Fuites internes à des bibliothèques système (hors de StudyLab), ignorées par LeakSanitizer.
# Qt PDF 6.4 ne libère pas son chargeur asynchrone quand un fichier n'est pas un PDF valide.
leak:libQt6Pdf.so
# Chromium (Qt WebEngine) : bibliothèque non instrumentée, allocations libérées par ses propres ramasse-miettes.
# Le contrôle new/delete est aussi désactivé dans le préréglage ASan (faux positifs dans ~WebContentsAdapter).
leak:libQt6WebEngineCore.so
# Fontconfig, interrogé par Chromium pour les polices des livres.
leak:libfontconfig.so
